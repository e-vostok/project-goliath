# Project Goliath — PRODUCTION environment template.
# Copy to .env on the server (chmod 600, owner = deploy user) and fill in
# real values. The repo is public: never commit a filled-in .env.
# Every variable below is consumed either by docker-compose.prod.yml or
# read from os.environ inside backend/src.

# ── Database container ────────────────────────────────────────────────
# PostgreSQL superuser name for the `db` service.
POSTGRES_USER=goliath
# Database name created by the `db` service on first boot.
POSTGRES_DB=goliath
# PostgreSQL password. Letters and digits ONLY — it is embedded verbatim
# into DATABASE_URL below, so the two values must match exactly.
POSTGRES_PASSWORD=CHANGE_ME

# Backend SQLAlchemy URL. Async driver required; host is the `db`
# compose service name, never localhost.
DATABASE_URL=postgresql+asyncpg://goliath:CHANGE_ME@db:5432/goliath

# DATABASE_URL_TEST must NEVER be set on a server: the `pytest -m
# postgres` suite drops and rebuilds the entire target schema.
# It exists only for local/CI destructive testing.

# ── Application secrets ───────────────────────────────────────────────
# JWT signing key for Bearer tokens issued by /api/v1/auth/vk.
# Generate a fresh random value (32+ chars) for production.
JWT_SECRET_KEY=CHANGE_ME

# VK Mini App secret from dev.vk.com. Fixed by the VK cabinet — must be
# identical to the one used locally; it cannot be regenerated at will.
VK_APP_SECRET=CHANGE_ME

# Comma-separated VK user ids allowed into the admin panel
# (e.g. "123456789"). Empty = no admins (fails closed).
ADMIN_VK_USER_IDS=

# Optional override for the map data directory; the image already ships
# <repo>/data/map, so leave this UNSET in production.
#MAP_DATA_DIR=

# ── HTTPS / ingress (consumed by the caddy container) ─────────────────
# Public domain serving the app. Its DNS A-record must already point at
# the server before first boot, or certificate issuance fails.
DOMAIN=CHANGE_ME
# Contact e-mail for ACME (Let's Encrypt) certificate issuance.
ACME_EMAIL=CHANGE_ME

# ── Production guards (consumed by DEP-4, declared now) ───────────────
# Enables strict startup checks (JWT key strength, non-localhost DB).
APP_ENV=production
# Gates the world-reset endpoint: false -> 403 RESET_DISABLED.
ADMIN_ALLOW_RESET=false

# VK_GROUP_TOKEN is intentionally absent: it is added only in the
# VK bot sprint, together with Callback API.
