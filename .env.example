# Project Goliath — environment variables. Copy to .env and fill in.

# Application database (async driver required).
# SQLite:  sqlite+aiosqlite:///./dev.db
# PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Dedicated PostgreSQL database for the destructive `pytest -m postgres`
# suite. Leave empty to skip those tests.
DATABASE_URL_TEST=

# VK Mini App authentication (from the VK developer console).
VK_APP_ID=
VK_APP_SECRET=
VK_CLIENT_SECRET=
VK_GROUP_ID=
VK_GROUP_TOKEN=

# JWT signing key for Bearer tokens issued by /api/v1/auth/vk.
JWT_SECRET_KEY=

# Comma-separated VK user ids allowed into the admin panel (empty = none).
ADMIN_VK_USER_IDS=

# Gates POST /api/v1/admin/state/reset (DEP-4): any truthy value
# (1/true/yes/on) enables the world-reset endpoint; anything else or an
# unset variable fails closed with 403 RESET_DISABLED.
# Local dev needs it ON so the admin panel can reset the world.
# On the production server it stays false until a reset is needed.
ADMIN_ALLOW_RESET=true

# Deployment mode for the production startup guard (DEP-4).
# production/prod/staging = strict: the app refuses to boot on a weak
# JWT_SECRET_KEY, a SQLite/loopback DATABASE_URL or a placeholder
# VK_APP_SECRET. Leave UNSET locally — unset means no checks.
APP_ENV=

# Map data directory for the 01_map startup sync (Spec Part 2).
# Defaults to <repo>/data/map — set only to point the app at another map.
# Tests point it at backend/tests/fixtures/map_mini.
MAP_DATA_DIR=
